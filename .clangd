CompileFlags:
  Add:
    # clangd evaluates relative includes from each source file's directory.
    # All project C sources are two directories below the repository root.
    - -I../../_opam/lib/ocaml
    - -I../../vendor/libuv/include
    - -I../../vendor/libuv/src
    - -I../../vendor/libuv/src/unix
    - -I../../vendor/s2n-tls
    - -I../../vendor/s2n-tls/api
    - -I../../vendor/s2n-tls/tls
    - -I../../vendor/llhttp/include
    - -I../../vendor/llhttp/src
    - -D_GNU_SOURCE
    - -D_POSIX_C_SOURCE=200112
    - -D_FILE_OFFSET_BITS=64
    - -D_LARGEFILE_SOURCE
    - -fPIC
    - -Wno-unused-parameter
