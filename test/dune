(test
 (name integration_http)
 (modules integration_http)
 (libraries unix alcotest)
 (deps
  %{exe:demo_server.exe}
  fixtures/tls-cert.pem
  fixtures/tls-key.pem
  fixtures/tls-ticket-keys-malformed.txt)
 (action
  (setenv
   HALO_SERVER_BIN
   %{exe:demo_server.exe}
   (setenv
    HALO_TLS_CERT_FIXTURE
    %{dep:fixtures/tls-cert.pem}
    (setenv
     HALO_TLS_KEY_FIXTURE
     %{dep:fixtures/tls-key.pem}
     (setenv
      HALO_TLS_TICKET_KEYS_MALFORMED_FIXTURE
      %{dep:fixtures/tls-ticket-keys-malformed.txt}
      (run %{test})))))))

