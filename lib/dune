(rule
 (target system_c_library_flags.sexp)
 (enabled_if (= %{system} macosx))
 (action
  (with-stdout-to %{target}
   (echo "()"))))

(rule
 (target system_c_library_flags.sexp)
 (enabled_if (<> %{system} macosx))
 (action
  (with-stdout-to %{target}
   (echo "(-ldl -lrt)"))))

