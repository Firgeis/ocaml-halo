# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Fast OCaml HTTP 1.1 server"
description: "Fast Ocaml HTTP 1.1 server with C runtime for performance"
authors: ["Ezequiel Lewin <firgeis@gmail.com>"]
license: "MIT"
homepage: "https://github.com/firge/ocaml-halo"
bug-reports: "https://github.com/firge/ocaml-halo/issues"
depends: [
  "dune" {>= "3.15"}
  "conf-libssl" {build}
  "conf-pkg-config" {build}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/firge/ocaml-halo.git"
